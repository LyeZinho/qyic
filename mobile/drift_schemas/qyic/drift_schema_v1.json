  "fixed_sql": [
    {
      "name": "decks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"decks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"author\" TEXT NOT NULL DEFAULT '', \"locale\" TEXT NOT NULL DEFAULT 'en', \"version\" INTEGER NOT NULL DEFAULT 1, \"created_at_ms\" INTEGER NOT NULL, \"updated_at_ms\" INTEGER NOT NULL, \"deleted_at_ms\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "quizzes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quizzes\" (\"id\" TEXT NOT NULL, \"deck_id\" TEXT NOT NULL REFERENCES decks (id), \"type\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, \"question\" TEXT NOT NULL, \"explanation\" TEXT NOT NULL DEFAULT '', \"created_at_ms\" INTEGER NOT NULL, \"updated_at_ms\" INTEGER NOT NULL, \"deleted_at_ms\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "quiz_options",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quiz_options\" (\"quiz_id\" TEXT NOT NULL REFERENCES quizzes (id) ON DELETE CASCADE, \"id\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"text\" TEXT NOT NULL, \"prompt\" TEXT NOT NULL DEFAULT '', \"media_path\" TEXT NOT NULL DEFAULT '', \"is_correct\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_correct\" IN (0, 1)), PRIMARY KEY (\"quiz_id\", \"id\"));"
        }
      ]
    },
    {
      "name": "card_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"card_states\" (\"quiz_id\" TEXT NOT NULL REFERENCES quizzes (id) ON DELETE CASCADE, \"deck_id\" TEXT NOT NULL REFERENCES decks (id), \"phase\" INTEGER NOT NULL, \"step\" INTEGER NULL, \"stability\" REAL NULL, \"difficulty\" REAL NULL, \"due_at_ms\" INTEGER NOT NULL, \"last_reviewed_at_ms\" INTEGER NULL, \"reps\" INTEGER NOT NULL DEFAULT 0, \"lapses\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"quiz_id\"));"
        }
      ]
    },
    {
      "name": "review_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"client_id\" TEXT NOT NULL, \"client_seq\" INTEGER NOT NULL, \"quiz_id\" TEXT NOT NULL, \"deck_id\" TEXT NOT NULL, \"rating\" INTEGER NOT NULL, \"reviewed_at_ms\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL, UNIQUE (\"client_id\", \"client_seq\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
