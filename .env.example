# Copy to `.env` and adjust. Never commit real credentials.

# --- API ---
BIND_ADDR=0.0.0.0:8080
RUST_LOG=qyic_server=info,tower_http=info
# Public origin of the web client; magic links point here.
APP_BASE_URL=http://localhost:5173

# --- Database (local docker compose defaults) ---
DATABASE_URL=postgres://qyic:qyic_dev@localhost:5432/qyic_dev

# --- Passwordless auth e-mail ---
# Leave SMTP_HOST empty for local dev: magic links are printed in the API log
# and returned in the login response as `devMagicLink`.
AUTH_FROM_EMAIL=no-reply@qyic.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
